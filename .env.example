# Touchstone configuration. Copy to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. Nothing in this file is a
# real value — endpoints and keys are placeholders.
#
# Precedence: an existing environment variable wins over `.env`, so you can
# override any of these per-command without editing the file:
#
#   LITELLM_BASE_URL=https://other.example/v1 bench run tetris --model ...
#
# Inference profiles reference these with ${VAR} or ${VAR:-default} syntax, so a
# profile can be committed without carrying an endpoint or a credential.

# ---------------------------------------------------------------- the harness

# Where the pi CLI lives. Defaults to `pi` on PATH.
# TOUCHSTONE_PI_BIN=pi

# pi's config directory, which supplies models.json and auth.json. Touchstone
# reads it to build each run's agent directory, and never copies credentials into
# a run: auth.json is symlinked and apiKey fields are stripped.
# TOUCHSTONE_PI_AGENT_DIR=~/.pi/agent

# Headless browser used by page-level graders. Defaults to the macOS Chrome path.
# CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ------------------------------------------------------------------- endpoints

# A gateway (LiteLLM, vLLM, or anything OpenAI-compatible) serving one or more
# models. Point this at your own host.
LITELLM_BASE_URL=https://gateway.example.internal/v1
LITELLM_API_KEY=sk-replace-me

# A local runtime, e.g. llama.cpp's server with --host 127.0.0.1 --port 8080.
# Local runtimes often need no key at all.
LOCAL_LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLAMA_API_KEY=

# --------------------------------------------------------------- judge models

# Used by judged tasks (Plan 2). Pick models you can actually reach from where
# you are, and never the same family as the model under test.
# JUDGE_PRIMARY_MODEL=deepseek/deepseek-v4-pro
# JUDGE_AUDIT_MODEL=z-ai/glm-5.3

# OpenRouter, if you judge through it.
# OPENROUTER_API_KEY=sk-or-replace-me
